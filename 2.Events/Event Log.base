views:
  - type: table
    name: Table
    filters:
      and:
        - file.hasTag("date")
    order:
      - file.name
      - fc-date
      - fc-end
      - fc-calendar
      - fc-category
      - file.tags
    sort:
      - property: fc-date
        direction: ASC
    columnSize:
      note.fc-date: 124

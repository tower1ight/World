properties:
  note.Appearance:
    displayName: Appearance
views:
  - type: table
    name: Table
    filters:
      and:
        - file.hasTag("NPC")
    order:
      - file.name
      - tags
      - Ancestry
      - Appearance
    sort:
      - property: Ancestry
        direction: DESC
      - property: Appearance
        direction: DESC
      - property: file.links
        direction: ASC
